{
  "name": "dsh-buddy",
  "productName": "DSH Buddy",
  "version": "0.4.4",
  "description": "A desktop buddy for DeepSeek Harness",
  "main": "main.js",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "dist": "electron-builder --mac --publish never",
    "pack": "electron-builder --dir",
    "postinstall": "node scripts/patch-dsh-no-window.js && node scripts/patch-multimodal-ui.js",
    "predist": "node scripts/patch-dsh-no-window.js --check && node scripts/patch-multimodal-ui.js --check && node scripts/build-web-profile.js",
    "dist:win": "node scripts/patch-dsh-no-window.js --check && node scripts/patch-multimodal-ui.js --check && node scripts/build-web-profile.js && electron-builder --win --publish never"
  },
  "license": "MIT",
  "workspaces": [
    "plugins/*"
  ],
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.5-rc.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.5-rc.1",
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.1",
    "@deepseek-ai/dsh-bash-local": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.5-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.1",
    "@deepseek-ai/dsh-hook-protocol": "0.1.5-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.1",
    "@deepseek-ai/dsh-jobs": "0.1.5-rc.1",
    "@deepseek-ai/dsh-output-retention": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.1",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-query": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-shell": "0.1.5-rc.1",
    "@deepseek-ai/dsh-spill": "0.1.5-rc.1",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.5-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.5-rc.1",
    "@deepseek-ai/dsh-util-time": "0.1.5-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.5-rc.1",
    "@deepseek-ai/dsh-workflow": "0.1.5-rc.1",
    "electron-updater": "6.8.9",
    "tar": "7.5.22",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true,
    "electron-winstaller@5.4.0": true,
    "koffi@3.1.6": true,
    "node-pty@1.2.0-beta.15": true,
    "@deepseek-ai/dsh-subprocess-local@0.1.5-rc.1": true
  },
  "build": {
    "appId": "com.dshbuddy.app",
    "productName": "DSH Buddy",
    "files": [
      "**/*",
      "!docs${/*}",
      "!dist${/*}",
      "!dist-*${/*}"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**",
      "plugins/**"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        },
        {
          "target": "dir",
          "arch": "arm64"
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "-",
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "build/web-profile.tar.gz",
        "to": "web-profile.tar.gz"
      }
    ],
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Buddy",
      "deleteAppDataOnUninstall": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HackSing",
        "repo": "dsh-buddy"
      }
    ]
  }
}

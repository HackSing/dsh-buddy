{
  "name": "dsh-buddy",
  "productName": "DSH Buddy",
  "version": "0.1.0",
  "description": "A desktop buddy for DeepSeek Harness",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --publish never",
    "pack": "electron-builder --dir",
    "predist": "node scripts/build-web-profile.js",
    "dist:win": "node scripts/build-web-profile.js && electron-builder --win --publish never"
  },
  "license": "MIT",
  "workspaces": [
    "plugins/*"
  ],
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "@deepseek-ai/dsh-subprocess-local@0.1.0-rc.6": true,
    "@google/genai@1.52.0": true,
    "koffi@3.1.5": true,
    "node-pty@1.1.0": true,
    "protobufjs@7.6.5": true
  },
  "build": {
    "appId": "com.dshbuddy.app",
    "productName": "DSH Buddy",
    "files": [
      "**/*",
      "!docs${/*}"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**",
      "plugins/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "dir",
          "arch": "arm64"
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "build/web-profile.tar.gz",
        "to": "web-profile.tar.gz"
      }
    ],
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ]
    }
  }
}